# Instagram API Credentials
INSTA_ACCESS_TOKEN=your_access_token_here
INSTA_IG_ID=your_instagram_business_account_id_here
INSTA_APP_ID=your_app_id_here
INSTA_APP_SECRET=your_app_secret_here

# App Settings
DRY_RUN=true

# Optional: Manual Tunnel Configuration
# If you want to use your own tunnel (e.g. Cloudflare, VPS) instead of the built-in Ngrok integration:
# SKIP_TUNNEL=true
# PUBLIC_URL_PREFIX=https://your-public-host.com/